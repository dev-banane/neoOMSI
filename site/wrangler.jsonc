{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "neoomsi-site",
	"compatibility_date": "2026-10-04",
	"routes": [{ "pattern": "neoomsi.com", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
}
